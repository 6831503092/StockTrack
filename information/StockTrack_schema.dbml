// ==========================================
// StockTrack System - 16 Tables Schema (DBML) — v2.1
// For use on: https://dbdiagram.io
// ------------------------------------------
// v2.1 changes:
//  - USERS: + USERNAME (unique)
//  - APPROVAL_REQUESTS: + TARGET_TYPE, TARGET_ID, PAYLOAD; STATUS = PENDING / APPROVED / REJECTED
//  - PURCHASE_ORDERS / SALES_ORDERS: + REQUEST_ID (1:1 with APPROVAL_REQUESTS)
//  - AUDIT_LOGS: + ROLE (role snapshot at action time)
//  - All reason fields varchar(255), DETAIL varchar(255)
//  - Defaults / NOT NULL / status notes added
// ==========================================

// 1. กลุ่มข้อมูลหลัก (Master Data)
Table USERS {
  USER_ID integer [pk, increment]
  USERNAME varchar(30) [unique, not null, note: 'ใช้ล็อกอิน']
  FULL_NAME varchar(50) [not null]
  PASSWORD_HASH varchar(60) [not null, note: 'BCrypt']
  ROLE varchar(10) [not null, note: 'OWNER / MANAGER / ADMIN / STAFF']
  IS_ACTIVE boolean [not null, default: true]
}

Table ZONES {
  ZONE_ID integer [pk, increment]
  ZONE_CODE varchar(5) [unique, not null, note: 'เช่น Z1 = location ของสินค้า']
  ZONE_NAME varchar(30) [unique, not null]
}

Table SUPPLIERS {
  SUPPLIER_ID integer [pk, increment]
  COMPANY_NAME varchar(50) [not null]
  IS_ACTIVE boolean [not null, default: true]
}

Table CUSTOMERS {
  CUSTOMER_ID integer [pk, increment]
  CUSTOMER_NAME varchar(50) [not null]
  IS_ACTIVE boolean [not null, default: true]
}

Table PRODUCTS {
  PRODUCT_ID integer [pk, increment]
  PRODUCT_NAME varchar(50) [not null]
  DEFAULT_COST decimal(10,2) [not null, note: '> 0']
  SELLING_PRICE decimal(10,2) [not null, note: '> 0']
  CURRENT_STOCK integer [not null, default: 0, note: '>= 0; เปลี่ยนได้แค่ตอนรับ/จ่ายของ']
  MIN_STOCK_ALERT integer [not null, default: 20]
  PO_MIN_QTY integer [not null, default: 1]
  PO_MAX_QTY integer [null, note: 'NULL = ไม่จำกัด']
  SO_MIN_QTY integer [not null, default: 1]
  SO_MAX_QTY integer [null, note: 'NULL = ไม่จำกัด']
  ZONE_ID integer [not null]
  IS_ACTIVE boolean [not null, default: true]
}

// 2. กลุ่มสายงานสั่งซื้อและตรวจรับสินค้า (Inbound)
Table PURCHASE_ORDERS {
  PO_ID integer [pk, increment]
  SUPPLIER_ID integer [not null]
  CREATED_BY_USER_ID integer [not null]
  REQUEST_ID integer [unique, not null, note: 'คำขออนุมัติของ PO ใบนี้']
  ORDER_DATETIME datetime [not null]
  TOTAL_AMOUNT decimal(10,2) [not null]
  STATUS varchar(20) [not null, note: 'PENDING / APPROVED / REJECTED / RECEIVED / REJECTED_ON_RECEIPT']
}

Table PURCHASE_ORDER_ITEMS {
  PO_ITEM_ID integer [pk, increment]
  PO_ID integer [not null]
  PRODUCT_ID integer [not null]
  QUANTITY integer [not null]
  UNIT_COST decimal(10,2) [not null, note: 'price snapshot']
  SUBTOTAL decimal(10,2) [not null]
}

Table RECEIVING_CHECKS {
  CHECK_ID integer [pk, increment]
  PO_ID integer [unique, not null]
  CHECKED_BY_USER_ID integer [not null]
  CHECKED_DATETIME datetime [not null]
  RESULT varchar(10) [not null, note: 'ACCEPTED / REJECTED']
  REJECT_REASON varchar(255) [null, note: 'บังคับเมื่อ RESULT = REJECTED']
}

Table RECEIVING_CHECK_ITEMS {
  CHECK_ITEM_ID integer [pk, increment]
  CHECK_ID integer [not null]
  PO_ITEM_ID integer [not null]
  EXPECTED_QTY integer [not null]
  COUNTED_QTY integer [not null]
  IS_CORRECT_PRODUCT boolean [not null]
}

// 3. กลุ่มสายงานสั่งขายและตรวจจ่ายสินค้า (Outbound)
Table SALES_ORDERS {
  SO_ID integer [pk, increment]
  CUSTOMER_ID integer [not null]
  CREATED_BY_USER_ID integer [not null]
  REQUEST_ID integer [unique, not null, note: 'คำขออนุมัติของ SO ใบนี้']
  ORDER_DATETIME datetime [not null]
  TOTAL_AMOUNT decimal(10,2) [not null]
  STATUS varchar(20) [not null, note: 'PENDING / APPROVED / REJECTED / ISSUED / REJECTED_ON_ISSUE']
}

Table SALES_ORDER_ITEMS {
  SO_ITEM_ID integer [pk, increment]
  SO_ID integer [not null]
  PRODUCT_ID integer [not null]
  QUANTITY integer [not null]
  UNIT_COST_SNAPSHOT decimal(10,2) [not null]
  UNIT_PRICE decimal(10,2) [not null]
  SUBTOTAL decimal(10,2) [not null]
}

Table ISSUE_CHECKS {
  CHECK_ID integer [pk, increment]
  SO_ID integer [unique, not null]
  CHECKED_BY_USER_ID integer [not null]
  CHECKED_DATETIME datetime [not null]
  RESULT varchar(10) [not null, note: 'ISSUED / REJECTED']
  REJECT_REASON varchar(255) [null, note: 'บังคับเมื่อ RESULT = REJECTED']
}

Table ISSUE_CHECK_ITEMS {
  CHECK_ITEM_ID integer [pk, increment]
  CHECK_ID integer [not null]
  SO_ITEM_ID integer [not null]
  EXPECTED_QTY integer [not null]
  COUNTED_QTY integer [not null]
  IS_CORRECT_PRODUCT boolean [not null]
}

// 4. กลุ่มคำขอ ย้ายคลัง และประวัติการทำงาน (Governance & Stock Movement)
Table APPROVAL_REQUESTS {
  REQUEST_ID integer [pk, increment]
  REQUEST_TYPE varchar(20) [not null, note: '''
    PRODUCT_CREATE / PRODUCT_UPDATE / PRODUCT_DELETE
    SUPPLIER_CREATE / SUPPLIER_UPDATE / SUPPLIER_DEACTIVATE
    CUSTOMER_CREATE / CUSTOMER_UPDATE / CUSTOMER_DEACTIVATE
    ZONE_CREATE / ZONE_UPDATE / PRODUCT_MOVE / ROLE_CHANGE
    PO_CREATE / SO_CREATE
  ''']
  TARGET_TYPE varchar(20) [null, note: 'PRODUCT / SUPPLIER / CUSTOMER / ZONE / USER (NULL สำหรับ PO/SO เพราะผูกผ่าน REQUEST_ID ของ order)']
  TARGET_ID integer [null, note: 'ID ของแถวที่จะแก้/ลบ/ย้าย/เปลี่ยน role; NULL ถ้าเป็นการเพิ่มใหม่']
  PAYLOAD text [null, note: 'JSON ข้อมูลที่ขอ เช่น {"productName":"Wooden bed","defaultCost":800,...}']
  DETAIL varchar(255) [not null, note: 'ข้อความสรุปให้คนอ่าน']
  STATUS varchar(10) [not null, default: 'PENDING', note: 'PENDING / APPROVED / REJECTED']
  REQUESTED_BY_USER_ID integer [not null]
  REQUESTED_DATETIME datetime [not null]
  DECIDED_BY_USER_ID integer [null]
  DECIDED_DATETIME datetime [null]
  DECISION_REASON varchar(255) [null, note: 'บังคับเมื่อ REJECTED (รวมกรณีระบบตรวจซ้ำไม่ผ่านตอน approve)']
}

Table STOCK_MOVEMENTS {
  MOVEMENT_ID integer [pk, increment]
  REQUEST_ID integer [unique, not null]
  PRODUCT_ID integer [not null]
  FROM_ZONE_ID integer [not null]
  TO_ZONE_ID integer [not null]
  QUANTITY integer [not null]
  STATUS varchar(20) [not null, note: 'PENDING_VERIFICATION / COMPLETED / REJECTED']
  COUNTED_QTY integer [null]
  VERIFIED_BY_USER_ID integer [null]
  VERIFIED_DATETIME datetime [null]
  REJECT_REASON varchar(255) [null]
}

Table AUDIT_LOGS {
  LOG_ID integer [pk, increment]
  USER_ID integer [not null]
  ROLE varchar(10) [not null, note: 'role ณ เวลาที่ทำ action']
  ACTION_TYPE varchar(20) [not null]
  DETAIL varchar(255) [not null]
  ACTION_DATETIME datetime [not null]
}

// ==========================================
// ความสัมพันธ์ระหว่างตาราง (Relationships)
// '<' = 1 ต่อ กลุ่ม (1:N)
// '-' = 1 ต่อ 1 (1:1)
// ==========================================

// USERS Relationships (8 เส้น)
Ref: USERS.USER_ID < APPROVAL_REQUESTS.REQUESTED_BY_USER_ID
Ref: USERS.USER_ID < APPROVAL_REQUESTS.DECIDED_BY_USER_ID
Ref: USERS.USER_ID < PURCHASE_ORDERS.CREATED_BY_USER_ID
Ref: USERS.USER_ID < RECEIVING_CHECKS.CHECKED_BY_USER_ID
Ref: USERS.USER_ID < SALES_ORDERS.CREATED_BY_USER_ID
Ref: USERS.USER_ID < ISSUE_CHECKS.CHECKED_BY_USER_ID
Ref: USERS.USER_ID < STOCK_MOVEMENTS.VERIFIED_BY_USER_ID
Ref: USERS.USER_ID < AUDIT_LOGS.USER_ID

// ZONES Relationships (3 เส้น)
Ref: ZONES.ZONE_ID < PRODUCTS.ZONE_ID
Ref: ZONES.ZONE_ID < STOCK_MOVEMENTS.FROM_ZONE_ID
Ref: ZONES.ZONE_ID < STOCK_MOVEMENTS.TO_ZONE_ID

// SUPPLIERS & CUSTOMERS (2 เส้น)
Ref: SUPPLIERS.SUPPLIER_ID < PURCHASE_ORDERS.SUPPLIER_ID
Ref: CUSTOMERS.CUSTOMER_ID < SALES_ORDERS.CUSTOMER_ID

// PRODUCTS Relationships (3 เส้น)
Ref: PRODUCTS.PRODUCT_ID < PURCHASE_ORDER_ITEMS.PRODUCT_ID
Ref: PRODUCTS.PRODUCT_ID < SALES_ORDER_ITEMS.PRODUCT_ID
Ref: PRODUCTS.PRODUCT_ID < STOCK_MOVEMENTS.PRODUCT_ID

// APPROVAL_REQUESTS (1:1) — คำขอผูกกับ order / การย้ายโซน
Ref: APPROVAL_REQUESTS.REQUEST_ID - STOCK_MOVEMENTS.REQUEST_ID
Ref: APPROVAL_REQUESTS.REQUEST_ID - PURCHASE_ORDERS.REQUEST_ID
Ref: APPROVAL_REQUESTS.REQUEST_ID - SALES_ORDERS.REQUEST_ID

// Purchasing & Receiving Checks (4 เส้น)
Ref: PURCHASE_ORDERS.PO_ID < PURCHASE_ORDER_ITEMS.PO_ID
Ref: PURCHASE_ORDERS.PO_ID - RECEIVING_CHECKS.PO_ID
Ref: RECEIVING_CHECKS.CHECK_ID < RECEIVING_CHECK_ITEMS.CHECK_ID
Ref: PURCHASE_ORDER_ITEMS.PO_ITEM_ID < RECEIVING_CHECK_ITEMS.PO_ITEM_ID

// Sales & Issue Checks (4 เส้น)
Ref: SALES_ORDERS.SO_ID < SALES_ORDER_ITEMS.SO_ID
Ref: SALES_ORDERS.SO_ID - ISSUE_CHECKS.SO_ID
Ref: ISSUE_CHECKS.CHECK_ID < ISSUE_CHECK_ITEMS.CHECK_ID
Ref: SALES_ORDER_ITEMS.SO_ITEM_ID < ISSUE_CHECK_ITEMS.SO_ITEM_ID

// ==========================================
// การจัดกลุ่มสีใน dbdiagram (TableGroups)
// ==========================================
TableGroup Master_Data {
  USERS
  ZONES
  SUPPLIERS
  CUSTOMERS
  PRODUCTS
}

TableGroup Inbound_Purchasing {
  PURCHASE_ORDERS
  PURCHASE_ORDER_ITEMS
  RECEIVING_CHECKS
  RECEIVING_CHECK_ITEMS
}

TableGroup Outbound_Sales {
  SALES_ORDERS
  SALES_ORDER_ITEMS
  ISSUE_CHECKS
  ISSUE_CHECK_ITEMS
}

TableGroup Governance_And_Movements {
  APPROVAL_REQUESTS
  STOCK_MOVEMENTS
  AUDIT_LOGS
}
